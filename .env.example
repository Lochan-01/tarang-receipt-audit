# ==============================================================================
# Tarang Pharma Distribution - Environment Configuration
# ==============================================================================

# OPTIONAL: Vision LLM API Key (Google Gemini)
# If provided, high-accuracy cloud vision LLM is used.
# If omitted or left blank, system runs gracefully in local offline mode using RapidOCR.
GEMINI_API_KEY=

# OPTIONAL: OpenAI API Key (alternative provider)
OPENAI_API_KEY=

# Service Port Configuration
PORT=8000
HOST=0.0.0.0
